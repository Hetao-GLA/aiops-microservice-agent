SERVICE_NAME=order-service
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/operations

# Host-side human-approved operations Agent
OPS_AGENT_TARGET_BASE_URL=http://localhost:8000
OPS_AGENT_DATA_DIR=data/agent
OPS_AGENT_DETECTION_PATH=data/detections/detections.jsonl
OPS_AGENT_PROJECT_ROOT=.
OPS_AGENT_COMPOSE_FILE=docker-compose.yml
OPS_AGENT_PLANNER=deterministic

